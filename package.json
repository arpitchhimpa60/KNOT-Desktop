{
  "name": "knot-desktop",
  "version": "1.0.0",
  "description": "KNOT is a lightweight, real-time desktop messaging application inspired by modern messaging platforms.",
  "main": "electron/main.js",
  "scripts": {
    "client": "npm run dev --prefix client",
    "electron": "electron .",
    "build:frontend": "npm run build --prefix client",
    "dist:mac": "npm run build:frontend && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.knot.desktop",
    "productName": "KNOT",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/coverage/**",
          "!**/.env",
          "!**/.env.*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitchhimpa60/KNOT-Desktop.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/arpitchhimpa60/KNOT-Desktop/issues"
  },
  "homepage": "https://github.com/arpitchhimpa60/KNOT-Desktop#readme",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3"
  }
}
